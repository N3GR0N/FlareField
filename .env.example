# Copy this file to .env.local and fill in your keys locally (do NOT commit .env.local)
# Enable MapLibre integration
NEXT_PUBLIC_USE_MAPLIBRE=1

# Dark map style URL (MapTiler). Replace YOUR_MAPTILER_KEY with your key.
NEXT_PUBLIC_MAP_STYLE=https://api.maptiler.com/maps/streets-v2-dark/style.json?key=YOUR_MAPTILER_KEY

# MapTiler key (or other provider key) for tiles/DEM if needed
NEXT_PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY

# Optional: use another style provider or tiles endpoint
# NEXT_PUBLIC_MAP_STYLE=https://your-tiles.example.com/style.json
